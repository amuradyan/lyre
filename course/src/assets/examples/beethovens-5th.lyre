; Beethoven's 5th Symphony
(sequence
    (silence 1000)

    (harmony (tone G3 300) (tone Eb3 300))   ; da
    (harmony (tone G3 300) (tone Eb3 300))   ; da
    (harmony (tone G3 300) (tone Eb3 300))   ; da
    (harmony (tone Eb3 1500) (tone G2 1500)) ; DUMMMM

    (silence 600)

    (harmony (tone F3 300) (tone B2 300))    ; da
    (harmony (tone F3 300) (tone B2 300))    ; da
    (harmony (tone F3 300) (tone B2 300))    ; da
    (harmony (tone D3 1500) (tone G2 1500))) ; DUMMMM
