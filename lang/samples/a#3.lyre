; Additive version - per-harmonic envelopes from spectrum analyzer

(gain
  (harmony
    (gain (envelope 0.003 0.03 0.6 1.5 0 (sine 237)) 0.12)
    (gain (envelope 0.003 0.04 0.5 1.3 0 (sine 473)) 0.18)
    (gain (envelope 0.003 0.04 0.45 1.2 0 (sine 947)) 0.14)
    (gain (envelope 0.003 0.05 0.35 1.0 0 (sine 1873)) 0.22)
    (gain (envelope 0.003 0.05 0.28 0.8 0 (sine 2347)) 0.08)
    (gain (envelope 0.003 0.05 0.22 0.6 0 (sine 3747)) 0.06)
    (gain (envelope 0.003 0.05 0.18 0.5 0 (sine 4220)) 0.16)
    (gain (envelope 0.003 0.05 0.12 0.3 0 (sine 5663)) 0.08)
    (gain (envelope 0.003 0.05 0.08 0.2 0 (sine 6158)) 0.08)
    (gain (envelope 0.003 0.05 0.05 0.15 0 (sine 8635)) 0.10)
    (gain (envelope 0.003 0.05 0.03 0.1 0 (sine 9647)) 0.18))
  1.5)

; -------------------------------------------------------
; Filter version - triangle base with lowpass sweep

(envelope 0.003 0.8 0 1.2 0
  (lowpass (+ 800 (* 8000 (envelope 0 0 1 1.0 0 (dc 1))))
    (gain
      (harmony
        (triangle 237)
        (gain (sine 473) 1.5)
        (gain (sine 947) 1.2))
      1.5)))
