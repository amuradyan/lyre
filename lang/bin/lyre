#!/usr/bin/env node
import { compute, stream } from '../src/language/runner.js';
import { tokenize, desugar } from '../src/language/tokenizer.js';
import { readFileSync } from 'fs';
import { spawn } from 'child_process';

const args = process.argv.slice(2);
const playMode = args.includes('--play');
const desugarMode = args.includes('--desugar');
const debugMode = args.includes('--debug');
const streamMode = args.includes('--stream') || playMode;
const filePath = args.find(arg => !arg.startsWith('--'));

if (desugarMode) {
  const code = readFileSync(filePath, 'utf-8');
  const tokens = desugar(tokenize(code));
  console.log(JSON.stringify(tokens, null, 2));
  process.exit(0);
}

const value = streamMode ? stream(filePath) : compute(filePath);

if (debugMode) {
  console.log('sample\tn\ttotal');
  for (const [sample, n, total] of value) {
    console.log(`${sample}\t${n}\t${total}`);
  }
  process.exit(0);
}

const buffer = Buffer.allocUnsafe(4);

if (playMode) {
  const ffplay = spawn('ffplay', ['-f', 'f32le', '-ar', '48000', '-autoexit', '-'], {
    stdio: ['pipe', 'inherit', 'inherit']
  });

  for (const [sample] of value) {
    buffer.writeFloatLE(sample, 0);
    ffplay.stdin.write(Buffer.from(buffer));
  }

  ffplay.stdin.end();
} else {
  for (const [sample] of value) {
    buffer.writeFloatLE(sample, 0);
    process.stdout.write(Buffer.from(buffer));
  }
}
